# optionnel : migration d'un groupe vers Pedalons (voir README, "Migration vers Pédalons").
# Les cinq valeurs vont ensemble : toutes vides = fonction eteinte, une partie seulement = refus
# de demarrer. Secrets a generer avec `openssl rand -base64 32`, identiques des deux cotes.
# URL publique de Pedalons, vers laquelle le navigateur de l'administrateur est redirige
PEDALONS_URL=
# URL de Pedalons pour les appels M2M (declenchement et suivi), https:// obligatoire (http:// seulement
# vers localhost), en general la meme que PEDALONS_URL : pas de VPN, les secrets ci-dessous protegent l'echange
PEDALONS_INTERNAL_URL=
# cle HMAC (base64, 32 octets minimum) qui signe le jeton de demande = PEDALONS_BIKETEAM_REQUEST_KEY de Pedalons
PEDALONS_REQUEST_KEY=
# secret envoye a Pedalons (en-tete X-Biketeam-Migration-Secret) = PEDALONS_BIKETEAM_TRIGGER_SECRET de Pedalons
PEDALONS_TRIGGER_SECRET=
# secret attendu de Pedalons sur /internal/pedalons/** (en-tete X-Pedalons-Export-Secret) = PEDALONS_BIKETEAM_EXPORT_SECRET de Pedalons
PEDALONS_EXPORT_SECRET=
# code des redirections d'un groupe bascule : 302 (defaut) ou 301. Rester en 302 tant que des
# bascules peuvent etre annulees (un 301 est garde sans fin par les navigateurs), passer a 301
# une fois les bascules stabilisees
PEDALONS_REDIRECT_STATUS=302
# true : masque l'entree « Migrer vers Pédalons » du menu d'administration du groupe (defaut false) ;
# la migration reste possible par l'URL /{teamId}/admin/pedalons
PEDALONS_MENU_HIDDEN=false
